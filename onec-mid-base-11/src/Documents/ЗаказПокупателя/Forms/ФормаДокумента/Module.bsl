
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
    // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
    // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
    ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	РассчитатьСуммуСтроки(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	РассчитатьСуммуСтроки(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	РассчитатьСуммуДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСкидкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	
	РассчитатьСуммуСтроки(ТекущиеДанные);
	
КонецПроцедуры

//++БалакинАВ
&НаКлиенте
Асинх Процедура ПриИзмененииСкидки() Экспорт 
	
	КоличествоТовары = Объект.Товары.Количество(); 
	КоличествоУслуги = Объект.Услуги.Количество();
	Если (КоличествоТовары + КоличествоУслуги) = 0 Тогда
		Возврат;
	КонецЕсли;

	Вопрос = ВопросАсинх("Изменен процент скидки. Пересчитать таблицу товаров и услуг?", РежимДиалогаВопрос.ДаНет); 
	Ответ = Ждать Вопрос; 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда 
		ПересчитатьТаблициСУчетомСкидки();
		РассчитатьСуммуДокумента();
	КонецЕсли;
КонецПроцедуры    

&НаКлиенте
Процедура КомандаПересчитатьТаблицу(Команда) Экспорт  
	ПересчитатьТаблициСУчетомСкидки();
	РассчитатьСуммуДокумента();
КонецПроцедуры    

&НаКлиенте
Процедура ПересчитатьТаблициСУчетомСкидки()
	Для каждого ТекущиеТовары из Объект.Товары Цикл 
		РассчитатьСуммуСтроки(ТекущиеТовары);	
	КонецЦикла;
	Для каждого ТекущиеУслуги из Объект.Услуги Цикл 
		РассчитатьСуммуСтроки(ТекущиеУслуги);	
	КонецЦикла;
КонецПроцедуры
//++БалакинАВ


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУслуги

