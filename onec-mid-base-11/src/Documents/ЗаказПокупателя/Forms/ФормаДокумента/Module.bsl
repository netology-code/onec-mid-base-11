
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// (( Алекситович Д.Н. 20.01.2026 Добавление на форму поля "Контактное лицо"
	Элемент = Элементы.Вставить("Д_КонтактноеЛицо", Тип("ПолеФормы"), ЭтотОбъект.Элементы.ГруппаШапкаПраво);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным = "Объект.Д_КонтактноеЛицо";
	Элемент.Заголовок = "Контактное лицо";
	// ))
	
	
	// (( Алекситович Д.Н. 20.01.2026 Добавление на форму поля "Согласованная скидка"
	ГруппаСкидки = Элементы.Вставить("Д_ГруппаСкидки", Тип("ГруппаФормы"), ЭтотОбъект.Элементы.ГруппаШапкаЛево);
	ГруппаСкидки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Элемент = Элементы.Вставить("Д_СогласованнаяСкидка", Тип("ПолеФормы"), ЭтотОбъект.Элементы.Д_ГруппаСкидки);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным = "Объект.Д_СогласованнаяСкидка";
	Элемент.Заголовок = "Согласованная скидка";
	Элемент.УстановитьДействие("ПриИзменении", "Д_СогласованнаяСкидкаПриИзменении");
	// ))
	
	// (( Алекситович Д.Н. 20.01.2026 Добавление на форму команды "Пересчитать с учетом скидки"
	КомандаПересчитатьСУчетомСкидки = Команды.Добавить("Д_ПересчитатьСУчетомСкидки");
	КомандаПересчитатьСУчетомСкидки.Заголовок = "Пересчитать с учетом скидки";
	КомандаПересчитатьСУчетомСкидки.Действие = "Д_ПересчитатьСУчетомСкидки";
	
	КнопкаКоманды = Элементы.Вставить("Д_ПересчитатьСУчетомСкидки", Тип("КнопкаФормы"), ЭтотОбъект.Элементы.Д_ГруппаСкидки);
	КнопкаКоманды.ИмяКоманды = "Д_ПересчитатьСУчетомСкидки";
	КнопкаКоманды.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	// ))
КонецПроцедуры

