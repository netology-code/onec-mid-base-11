//+ Доработка команды согласованная скидка Привезенцева О.Е. 27.09.25
#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ПересчитатьТаблицу(Команда)
		СогласованнаяСкидка();
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции


&НаКлиенте
Процедура СогласованнаяСкидка() 
	
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;   
	
	Для Каждого ТекущиеДанные Из Объект.Товары  Цикл
		
		РассчитатьСуммуСтроки(ТекущиеДанные); 
		
	КонецЦикла;	 
	
	ТекущиеДанные = Элементы.Услуги.ТекущиеДанные;
	
	
	Для Каждого ТекущиеДанные Из Объект.Услуги  Цикл
		
		РассчитатьСуммуСтроки(ТекущиеДанные); 
		
	КонецЦикла;
	
КонецПроцедуры  

//- Конец доработки команды согласованная скидка Привезенцева О.Е.27.09.2025

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	////+ Доработка расчет согласованная скидка Привезенцева О.Е. 27.09.25
	//
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * (ТекущиеДанные.Цена - ТекущиеДанные.Цена * Объект.СогласованнаяСкидка/100);	   
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура СогласованнаяСкидкаПриИзмененииПосле()
	
	Если  Не ЗначениеЗаполнено(Объект.товары) И ЗначениеЗаполнено(Объект.Услуги) Тогда 
		Возврат;
	КонецЕсли;	
	
	Вопрос = ВопросАсинх("Изменен процент скидки. Пересчитать таблицу товаров и услуг?", РежимДиалогаВопрос.ДаНет);
	
	ОтветНаВопрос = Ждать Вопрос; 	
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда 
		
		СогласованнаяСкидка(); 
		
	КонецЕсли; 
	
КонецПроцедуры
//- Конец доработки расчет согласованная скидка Привезенцева О.Е.27.09.2025

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

