#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	// 22.04.2026 Гурьянова О.К. изм.1: расчёт суммы по строке с учетом согласованной скидки
	
	Скидка = ТекущиеДанные.Скидка + Объект.ДП_СогласованнаяСкидка;
	КоэффициентСкидки = 1 - Скидка / 100;
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	
	Если Скидка > 100 Тогда
	
		ТекущиеДанные.Сумма = 0;
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Суммарная скидка превышает 100%";
		Сообщение.Сообщить();
		Возврат;
	Иначе
		ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	КонецЕсли;
	// 22.04.2026  конец изм.1
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДП_ПриИзмененииСогласованнойСкидки(Элемент)
	
	// 22.04.2026 Гурьянова О.К. доп.3: Перерасёт таблиц при условии положительного ответа пользователя
	
	// Для пустой таблицы вопрос о перерасчёте не задавать
	Если Не ЗначениеЗаполнено(Объект.Товары) И Не ЗначениеЗаполнено(Объект.Услуги) Тогда
		Возврат;
	Иначе
		Ответ = Ждать ВопросАсинх("Для данного документа установлена дополнительная скидка.
	                           	  |Пересчитать сумму документа с учетом согласованной скидки?", РежимДиалогаВопрос.ДаНет);
	 
	    Если Ответ = КодВозвратаДиалога.Да Тогда
	    	ДП_ПересчитатьСУчетомСкидки();
	    КонецЕсли;     
	                      	  
	КонецЕсли;
	// 22.04.2026 конец доп.3

КонецПроцедуры

&НаКлиенте
Процедура ДП_ПересчитатьСУчетомСкидки()
	
	// 22.04.2026 Гурьянова О.К. доп.4: Пересчёт таблиц с учётом согласованной скидки
	
	// Пересчёт таблицы "Товары"
	Для Каждого ТекущаяСтрока  Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(ТекущаяСтрока);
	КонецЦикла;
	
	// Пересчёт таблицы "Услуги"
	Для Каждого ТекущаяСтрока  Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(ТекущаяСтрока);
	КонецЦикла;

    РассчитатьСуммуДокумента();
    // 22.04.2026 конец доп.4 
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

