#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//++ Миннахметов Радик___НачалоДоработки 21.07.2006
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество; 
	
	Скидка  = Объект.ДТК_СогласованнаяСкидка + ТекущиеДанные.Скидка;
	ТекущиеДанные.Сумма= ТекущиеДанные.Количество * (ТекущиеДанные.Цена - ТекущиеДанные.Цена * Скидка/100);
	
	//--Миннахметов Радик____КонецДоработки
	
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры


//++ Миннахметов Радик___21.07.2026
// Добавление обработчика события ПриИзменении реквизита ДТК_СогласованнаяСкидкаПриИзменении 
&НаКлиенте
Процедура  ДТК_СогласованнаяСкидкаПриИзменении (Элемент) Экспорт
	
	Если ЗначениеЗаполнено(Объект.Товары)  Или ЗначениеЗаполнено(Объект.Услуги) Тогда
		ЗадатьВопросАсинх(); 
	КонецЕсли;	

КонецПроцедуры //-- Миннахметов Радик___21.07.2026


//++ Миннахметов Радик___21.07.2026
&НаКлиенте 
Асинх Процедура ЗадатьВопросАсинх();
	
	Ответ = Ждать ВопросАсинх ("Изменен процент скидки. Выполнить пересчет таблиц товаров и услуг?", 
								РежимДиалогаВопрос.ДаНет);;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПересчитатьТаблицу(); 
	КонецЕсли; 
	
КонецПроцедуры //-- Миннахметов Радик___21.07.2026 


//++ Миннахметов Радик___21.07.2026
&НаКлиенте
Процедура КомандаПересчитатьТаблицу(Команда) Экспорт
	
	ПересчитатьТаблицу();
	
КонецПроцедуры //-- Миннахметов Радик___21.07.2026 
 

//++ Миннахметов Радик___21.07.2026
&НаКлиенте
Процедура  ПересчитатьТаблицу() Экспорт
	
	Для каждого Товар Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(Товар);
	КонецЦикла;  
	
	Для каждого Услуга Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(Услуга);
	КонецЦикла;   
	
	РассчитатьСуммуДокумента();
	
КонецПроцедуры //-- Миннахметов Радик___21.07.2026
 


