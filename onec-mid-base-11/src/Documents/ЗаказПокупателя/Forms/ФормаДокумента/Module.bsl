#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Д_СогласованнаяСкидкаПриИзменении ()
	//++ Хоменко В.И 22.01.26
	Если НЕ (Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0) Тогда
		ВопросПользователюАсинх();
	КонецЕсли;	
	//-- Хоменко В.И 22.01.26
КонецПроцедуры 

 &НаКлиенте
Асинх Процедура ВопросПользователюАсинх()
	//++ Хоменко В.И 22.01.26
	Обещание = ВопросАсинх("Изменен процент скидки. Пересчитать таблицу товаров и услуг?", РежимДиалогаВопрос.ДаНет);
	ОтветНаВопрос = Ждать Обещание;
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
	Д_ПересчитатьТаблицы();
	КонецЕсли;
	//-- Хоменко В.И 22.01.26
КонецПроцедуры 


&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	// Исходный код
	//++ Хоменко В.И 22.01.26
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	ОбщаяСкидка = ТекущиеДанные.Скидка + Объект.Д_СогласованнаяСкидка;
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * (ТекущиеДанные.Цена - ТекущиеДанные.Цена * ОбщаяСкидка/100); 
	//-- Хоменко В.И 22.01.26
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура Д_ПересчитатьТаблицы()
	//++ Хоменко В.И 22.01.26 
	Для Каждого Элемент Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(Элемент);
	КонецЦикла;
	
	Для Каждого Элемент Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(Элемент);
	КонецЦикла;
	
	РассчитатьСуммуДокумента();
	//-- Хоменко В.И 22.01.26
КонецПроцедуры


&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

