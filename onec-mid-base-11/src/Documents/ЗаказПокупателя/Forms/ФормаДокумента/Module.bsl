#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	РазмерСкидки = ТекущиеДанные.Скидка + Объект.ДЗ_СогласованнаяСкидка;
	ПроверкаСуммыСкидки = РазмерСкидки < 100;    
	
	Если ПроверкаСуммыСкидки Тогда
	
		КоэффициентСкидки = 1 - РазмерСкидки/100;	
	    ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;

	Иначе
		
		Сообщение = Новый СообщениеПользователю;
		
		Сообщение.Текст = СтрШаблон("По товару %1 привышен максимальный размер скидки", ТекущиеДанные.Номенклатура);
		Сообщение.Поле = ТекущиеДанные.Скидка;

		Сообщение.Сообщить();
		
	    ТекущиеДанные.Сумма = 0;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДЗ_ПриИзмененииСогласованнаяСкидка(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Товары) ИЛИ ЗначениеЗаполнено(Объект.Услуги) Тогда
		
		Вопрос = ВопросАсинх("Изменен процент скидки. Пересчитать скидку?",
		РежимДиалогаВопрос.ДаНет);
		
		ОтветНаВопрос = Ждать Вопрос;
		
		Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
			
			ДЗ_ПересчитатьТаблицуТовары();         	
			ДЗ_ПересчитатьТаблицуУслуги(); 
			РассчитатьСуммуДокумента();
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДЗ_ПересчитатьТаблицу(Команда)
	
    ДЗ_ПересчитатьТаблицуТовары();         	
	
	ДЗ_ПересчитатьТаблицуУслуги();  
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_ПересчитатьТаблицуТовары()
	
	Для Каждого СтрокаТовара из Объект.Товары Цикл
		
		РассчитатьСуммуСтроки(СтрокаТовара);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_ПересчитатьТаблицуУслуги()
	
	Для Каждого СтрокаУслуги из Объект.Услуги Цикл
		
		РассчитатьСуммуСтроки(СтрокаУслуги);
		
	КонецЦикла;
	
КонецПроцедуры


