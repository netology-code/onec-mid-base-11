//++ Хафизова А.А. 27.06.2026
// СогласованнаяСкидкаПриИзменении,ПересчитатьТаблицу 
&НаКлиенте
Процедура ДЗ_СогласованнаяСкидкаПриИзменении(Элемент)
	
    ТекущиеДанныеТовары = Элементы.Товары.ТекущиеДанные; 
	ТекущиеДанныеУслуги = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекущиеДанныеТовары = Неопределено И ТекущиеДанныеУслуги = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ДЗ_СогласованнаяСкидкаПриИзмененииЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Применить скидку?", Режим, 0);
	    
КонецПроцедуры 

&НаКлиенте
Процедура ДЗ_СогласованнаяСкидкаПриИзмененииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ДЗ_РассчитатьСуммуСтрок(); 
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте 
Процедура ДЗ_ПересчитатьТаблицу(Команда)
	
	ДЗ_РассчитатьСуммуСтрок();
	
КонецПроцедуры  

&НаКлиенте
Процедура ДЗ_РассчитатьСуммуСтрок() 
	
	Для Каждого Строка Из Объект.Товары Цикл
		
		РассчитатьСуммуСтроки(Строка);
		
	КонецЦикла; 
	
	Для Каждого Строка Из Объект.Услуги Цикл
		
		РассчитатьСуммуСтроки(Строка);
		
	КонецЦикла; 
	
КонецПроцедуры	

//-- Хафизова А.А.

#КонецОбласти

