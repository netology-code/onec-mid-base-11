// Начало. Борисов (дкл)

&НаКлиенте
Процедура дкл_СогласованнаяСкидкаПриИзменении(Элемент)
	
	// Если таблицы пустые - пересчитывать нечего
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Вопрос пользователю
	Оповещение = Новый ОписаниеОповещения("дкл_ПослеВопросаОПересчете", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Пересчитать суммы в документе с учетом скидки?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура дкл_ПослеВопросаОПересчете(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		дкл_ВыполнитьПересчетВсегоДокумента();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура дкл_КомандаПересчитать(Команда)
	дкл_ВыполнитьПересчетВсегоДокумента();
КонецПроцедуры

&НаКлиенте
Процедура дкл_ВыполнитьПересчетВсегоДокумента()
	
	Для Каждого СтрокаТовар Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(СтрокаТовар);
	КонецЦикла;
	
	Для Каждого СтрокаУслуга Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(СтрокаУслуга);
	КонецЦикла;
	
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

// Конец. Борисов (дкл)

