#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//usx добавил умножение на скидку
	Если (ТекущиеДанные.Скидка + Объект.СогласованнаяСкидка)> 100 Тогда КоэффициентСкидки = 0;
		Сообщить(СтрШаблон("Строка %1 содержит слишком высокую скидку по товару %2, суммарная скидка установлена на сто процентов", ТекущиеДанные.НомерСтроки, ТекущиеДанные.Номенклатура));
	Иначе
	КоэффициентСкидки = 1 - (Объект.СогласованнаяСкидка + ТекущиеДанные.Скидка) / 100;
	КонецЕсли;
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	РассчитатьСуммуДокумента();

	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

