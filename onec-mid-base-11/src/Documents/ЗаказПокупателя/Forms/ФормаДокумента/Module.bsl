КонецПроцедуры

&НаКлиенте
Асинх Процедура ПриИзмененииСогласованнаяСкидкаАсинх()
	
	Если Объект.Товары.Количество() = 0 и Объект.Услуги.Количество() = 0 Тогда 
	Иначе 
		Вопрос = ВопросАсинх("Была изменена скидка, провести пересчет?",РежимДиалогаВопрос.ДаНет,,,"Изменена скидка");  
		Результат = Ждать Вопрос;
		Если Результат = КодВозвратаДиалога.Да Тогда 
			ПересчетТабличнойЧастиТоварыУслуги();
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры
//-- Борисенко Д.С. 21.07.2006

