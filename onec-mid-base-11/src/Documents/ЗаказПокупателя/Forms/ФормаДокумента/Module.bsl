
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// 21.04.2026 Гурьянова О.К., доп.1: Добавление поля "Контактное лицо"
	ЭлементКонтактноеЛицо = Элементы.Вставить("ДП_КонтактноеЛицо", Тип("ПолеФормы"), Элементы.ГруппаШапкаПраво);
	ЭлементКонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементКонтактноеЛицо.ПутьКДанным = "Объект.ДП_КонтактноеЛицо";
	// 21.04.2026 конец доп.1
	
	// 22.04.2026 Гурьянова О.К. доп.2: Добавление поля "Согласованная скидка"
	//                                  и команды "Пересчитать сумму документа"
	Если Элементы.Найти("СогласованнаяСкидка") = Неопределено Тогда
		
		ГруппаСкидка = Элементы.Вставить("ГруппаСкидка", Тип("ГруппаФормы"), Элементы.ГруппаШапкаЛево);
		ГруппаСкидка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		
		// Добавление поля "Согласованная скидка"
		ЭлементСогласованнаяСкидка = Элементы.Добавить("ЭлементСогласованнаяСкидка", Тип("ПолеФормы"), ГруппаСкидка);
		ЭлементСогласованнаяСкидка.Вид = ВидПоляФормы.ПолеВвода;
		ЭлементСогласованнаяСкидка.ПутьКДанным = "Объект.ДП_СогласованнаяСкидка";
		ЭлементСогласованнаяСкидка.УстановитьДействие("ПриИзменении", "ДП_ПриИзмененииСогласованнойСкидки");
		
		// Добавление команды "Пересчитать сумму документа"
		Команда = Команды.Добавить("ПересчитатьСуммуДокумента");
		Команда.Заголовок = "Пересчитать сумму с учетом скидки";
		Команда.Действие = "Подключаемый_КомандаПересчитатьСуммуДокумента";
		
		КнопкаФормы = Элементы.Добавить("КнопкаПересчитатьСуммуДокумента", Тип("КнопкаФормы"), ГруппаСкидка);
		КнопкаФормы.ИмяКоманды = "ПересчитатьСуммуДокумента";
		КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		
	КонецЕсли;
	// 22.04.2026 конец доп.2
	
КонецПроцедуры

