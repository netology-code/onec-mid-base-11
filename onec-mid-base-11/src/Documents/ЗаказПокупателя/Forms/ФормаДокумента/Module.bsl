#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	 // Плиев 21.07.2026 Суммирование скидки в шапке документа со скидкой в тал. части
	// пересчет суммы с учетом общей  скидки
	
	СуммаСкидок = (Объект.ДЗ_СогласованнаяСкидка + ТекущиеДанные.Скидка)/100;
	
	Если СуммаСкидок <=1 Тогда
		ТекущиеДанные.Сумма = (ТекущиеДанные.Цена * ТекущиеДанные.Количество) - 
		(ТекущиеДанные.Цена * ТекущиеДанные.Количество)* СуммаСкидок ;
	Иначе
		ТекущиеДанные.Сумма = 0;
		Сообщение = Новый СообщениеПользователю();
        Сообщение.Текст = ("Сумма скидки не может быть больше 100");
        Сообщение.Сообщить();
		
	КонецЕсли;
	// Плиев 21.07.2026
	РассчитатьСуммуДокумента();
	
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

