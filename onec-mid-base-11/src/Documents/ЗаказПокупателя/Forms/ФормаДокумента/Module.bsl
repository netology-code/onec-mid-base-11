#Область ДК_СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДК_ДобавитьРеквизитСкидка() 
	
	ГруппаСкидка = Элементы.Добавить("ГруппаСкидка", Тип("ГруппаФормы"), Элементы.ГруппаШапкаЛево);
	ГруппаСкидка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСкидка.Поведение = ПоведениеОбычнойГруппы.Всплывающая;
	ГруппаСкидка.Заголовок = "Скидка";
	
	
	ЭлементСкидка = Элементы.Вставить("ДК_Скидка", Тип("ПолеФормы"), ГруппаСкидка);
	ЭлементСкидка.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементСкидка.Заголовок = "Скидка %";
	ЭлементСкидка.ПутьКДанным = "Объект.ДК_Скидка";  
	ЭлементСкидка.УстановитьДействие("ПриИзменении", "ДК_СкидкаПриИзменении");
	
	Команда = Команды.Добавить("ДК_ПересчитатьТаблицу");
	Команда.Заголовок = "Пересчитать таблицы";
	Команда.Действие = "ДК_ПересчитатьТаблицу";
	
	Кнопка = Элементы.Добавить("ДК_ПересчитатьТаблицу", Тип("КнопкаФормы"), ГруппаСкидка);
	Кнопка.ИмяКоманды = "ДК_ПересчитатьТаблицу";
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДК_СкидкаПриИзменении()
	
	Если ЗначениеЗаполнено(Объект.Товары) Или ЗначениеЗаполнено(Объект.Услуги) Тогда 
		ТекстВопроса = "Пересчитать суммы в табличных частях с учётом новой скидки?";
		Вопрос = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Если Вопрос = КодВозвратаДиалога.Да Тогда
			РасчитатьТаблицуСУчетомВсехСкидок();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура РК_РасчетСуммыСтроки(ТекущиеДанные)
	
	СкидкаПроцентом = Объект.ДК_Скидка;
	СкидкаВСтроке = ТекущиеДанные.Скидка;
	СуммаСкидок = СкидкаПроцентом + СкидкаВСтроке;
	
	Если СуммаСкидок <= 100 Тогда
		ТекущиеДанные.Сумма = (ТекущиеДанные.Цена * ТекущиеДанные.Количество) -
		(ТекущиеДанные.Цена * ТекущиеДанные.Количество) * СуммаСкидок / 100; 
	Иначе
		СуммаСкидок = 0;
		ТекущиеДанные.Сумма = СуммаСкидок; 
		ТекстСообщения = "Скидка превысила допустимую!";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура РасчитатьТаблицуСУчетомВсехСкидок()
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		РК_РасчетСуммыСтроки(ТекущаяСтрока);
	КонецЦикла; 
	
	Для Каждого ТекущаяСтрока Из Объект.Услуги Цикл
		РК_РасчетСуммыСтроки(ТекущаяСтрока);
	КонецЦикла; 
	
	РассчитатьСуммуДокумента();
	
КонецПроцедуры



