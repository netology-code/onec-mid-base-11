//++Варламов 22.04.2026	
&НаКлиенте
Процедура ТД_ПересчитатьТабличныеЧастиПоСкидке()

	Для Каждого СтрокаТовара Из Объект.Товары Цикл
          ТД_РассчитатьСуммуСтрокиТЧ(СтрокаТовара, Объект.ТД_СогласованнаяСкидка);
      КонецЦикла;

      Для Каждого СтрокаУслуги Из Объект.Услуги Цикл
          ТД_РассчитатьСуммуСтрокиТЧ(СтрокаУслуги, Объект.ТД_СогласованнаяСкидка);
      КонецЦикла;

      РассчитатьСуммуДокумента();

КонецПроцедуры

 &НаКлиенте
Процедура ТД_РассчитатьСуммуСтрокиТЧ(СтрокаТЧ, СкидкаШапки)

      // Суммируем скидки, но не более 100%
      ОбщаяСкидка = Мин(СкидкаШапки + СтрокаТЧ.Скидка, 100);
      КоэффициентСкидки = 1 - ОбщаяСкидка / 100;

      СтрокаТЧ.Сумма = СтрокаТЧ.Цена * СтрокаТЧ.Количество * КоэффициентСкидки;
	  
КонецПроцедуры
//--Варламов 22.04.2026
#КонецОбласти

