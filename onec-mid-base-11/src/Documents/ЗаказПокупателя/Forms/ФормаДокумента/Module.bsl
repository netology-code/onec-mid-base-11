#Область СлужебныеПроцедурыИФункции

//++ ВарламовАВ 22.04.2026
// Обработчик ответа пользователя на вопрос о пересчете сумм документа
// Параметры:
//   Результат - КодВозвратаДиалога - выбор пользователя
//   ДополнительныеПараметры - Булево - содержит ключ "ЕстьПревышение" 
//
&НаКлиенте
Процедура ТД_СогласованнаяСкидкаПриИзмененииЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ДополнительныеПараметры Тогда
		Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Есть превышение максимальной скидки";
        Сообщение.Сообщить();
		КонецЕсли;

		ТД_ПересчитатьТабличныеЧастиПоСкидке();

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//++Варламов 22.04.2026	
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	ТД_РассчитатьСуммуСтрокиТЧ(ТекущиеДанные, Объект.ТД_СогласованнаяСкидка);
	//--Варламов 22.04.2026	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

