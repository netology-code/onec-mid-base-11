#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//+++ Макаренко В.П. 25.01.2026
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	ОбщаяСкидка = ТекущиеДанные.Скидка + Объект.Дор_СогласованнаяСкидка;
	
	Если ОбщаяСкидка > 100 Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ("Сумма скидок не может быть больше 100%!");
		Сообщение.Сообщить();
		ТекущиеДанные.Скидка = 0;
		ОбщаяСкидка = Объект.Дор_СогласованнаяСкидка;	
	КонецЕсли;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена * (100 - ОбщаяСкидка) / 100;
	//--- Макаренко В.П. 25.01.2026

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗадатьВопросПользователю()
	
	//+++ Макаренко В.П. 25.01.2026
	Обещание = ВопросАсинх("Произвести пересчет стоимости номенклатуры с учетом скидки?", РежимДиалогаВопрос.ДаНет);
	Результат = Ждать Обещание; 
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПересчитатьТЧ();
	КонецЕсли;
	      	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТЧ()
	
	//+++ Макаренко В.П. 25.01.2026
	Для Каждого Строка Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(Строка);
	КонецЦикла;
	
	Для Каждого Строка Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(Строка);
	КонецЦикла;
	
КонецПроцедуры

