#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	// (( Алекситович Д.Н. 20.01.2026 Добавление расчета, учитывающего скидку
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	СкидкаИзТаблицы = ТекущиеДанные.Скидка / 100;
	Д_ИтоговаяСкидка = СкидкаИзТаблицы + Объект.Д_СогласованнаяСкидка / 100;
	
	Если Д_ИтоговаяСкидка > 1 Тогда
		Д_ИтоговаяСкидка = 1; 
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Текст = СтрШаблон("Скидка по товару %1 превышает 100 процентов", ТекущиеДанные.Номенклатура);
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена * (1 - Д_ИтоговаяСкидка);
	// ))
	
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура Д_ПересчитатьСУчетомСкидки(Команда)
	
	ПересчитатьСоСкидкой();
		
КонецПроцедуры  

&НаКлиенте
Асинх Процедура Д_СогласованнаяСкидкаПриИзменении(Элемент)
	
    Если ЗначениеЗаполнено(Объект.Товары) ИЛИ ЗначениеЗаполнено(Объект.Услуги) Тогда
		Вопрос = ВопросАсинх("Скидка изменена. Пересчитать таблицу товаров и услуг?", РежимДиалогаВопрос.ДаНет);
		ОтветНаВопрос = Ждать Вопрос;
		
		Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		   	ПересчитатьСоСкидкой();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

 &НаКлиенте
Процедура ПересчитатьСоСкидкой()
	
	ТекущиеДанныеТовары = Объект.Товары;
	Для Каждого Элемент Из ТекущиеДанныеТовары Цикл
		РассчитатьСуммуСтроки(Элемент);
	КонецЦикла;
	    
	ТекущиеДанныеУслуги = Объект.Услуги;
	Для Каждого Элемент Из ТекущиеДанныеУслуги Цикл
		РассчитатьСуммуСтроки(Элемент);
	КонецЦикла;
	
КонецПроцедуры 

