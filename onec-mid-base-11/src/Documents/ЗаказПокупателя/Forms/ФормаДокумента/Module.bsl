&НаКлиенте
Процедура Дор_СогласованнаяСкидкаПриИзменении(Элемент)
	
	//+++ Макаренко В.П. 25.01.2026
	Если Объект.Товары.Количество() > 0 ИЛИ Объект.Услуги.Количество() > 0 Тогда
		ЗадатьВопросПользователю();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

