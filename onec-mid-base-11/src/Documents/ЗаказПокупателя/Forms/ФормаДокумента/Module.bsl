#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//НачалоДоработки
	//Задача № 1
	//Пересчет суммы с учетом скидки
	///Старый код:	
	///ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	
	//Новый код
	ОбщаяСкидка = Объект.РС_СогласованнаяСкидка + ТекущиеДанные.Скидка;
	Если ОбщаяСкидка >= 100 Тогда
		ОбщаяСкидка = 100;
		Сообщить("Сумма скидки не может быть больше 100%");
		ТекущиеДанные.Сумма = 0;
	Иначе
		ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество - (ТекущиеДанные.Цена * ТекущиеДанные.Количество * ОбщаяСкидка / 100); 
	КонецЕсли;
	//КонецДоработки
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура РС_ПересчётСУчетомСкидкиВместо(Команда)
	
	ПересчитатьТаблицы()		
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТаблицы()
	
	Для каждого Элемент Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(Элемент);
	КонецЦикла;
	
	Для каждого Элемент Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(Элемент);
	КонецЦикла;
	                           
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура РС_СогласованнаяСкидкаПриИзмененииПосле(Элемент)
	// Вставить содержимое обработчика.
	Если ЗначениеЗаполнено(Объект.Товары) ИЛИ ЗначениеЗаполнено(Объект.Услуги) Тогда
		
		Вопрос = ВопросАсинх("Пересчитать таблицы товаров и услуг с учетом скидки?",РежимДиалогаВопрос.ДаНет);
		ОтветНаВопрос = Ждать Вопрос;
		
		Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
			
			ПересчитатьТаблицы();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

