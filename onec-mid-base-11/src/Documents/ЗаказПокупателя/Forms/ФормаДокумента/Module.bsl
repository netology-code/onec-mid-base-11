#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//++ СтудентНетология Зозуля Т.В. 27.01.2026
	//Уудалить исходный код расчета
	//	КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	////Доработка расчета суммы строки со скидкой ДЗ_13_2
	ИтоговаяСкидкаПроценты = Объект.СогласованнаяСкидка + ТекущиеДанные.Скидка;

	Если ИтоговаяСкидкаПроценты > 100 Тогда
		ИтоговаяСкидкаПроценты = 100;

		ТекстСообщение = СтрШаблон(
		"Скидка составляет больше 100 процетов. Стока %1, %2", ТекущиеДанные.НомерСтроки, ТекущиеДанные.Номенклатура);

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = (ТекстСообщение);
		Сообщение.Сообщить();

	КонецЕсли;
	
	//////Удалить
	//КоэффициентСкидки = 1 - ИтоговаяСкидкаПроценты / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	//-- СтудентНетология Зозуля Т.В. 27.01.2026

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()

	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");

КонецПроцедуры

//++ СтудентНетология Зозуля Т.В. 27.01.2026 Доработка расчета суммы документа ДЗ_13_2
&НаКлиенте
Процедура ДЗ_13_2_РассчитатьСуммуТаблиц()

	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(СтрокаТЧ);
	КонецЦикла;

	Для Каждого СтрокаТЧ Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(СтрокаТЧ);
	КонецЦикла;

	РассчитатьСуммуДокумента();

КонецПроцедуры
//-- СтудентНетология Зозуля Т.В. 27.01.2026

