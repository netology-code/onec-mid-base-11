
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//+++ Макаренко В.П. 25.01.2026
	НоваяКоманда = Команды.Добавить("Дор_ПересчитатьСУчетомСкидки");
	НоваяКоманда.Заголовок = "Пересчитать с учетом скидки";
	НоваяКоманда.Действие = "ПересчитатьСУчетомСкидки";
			
	НоваяГруппа = Элементы.Вставить("МояГруппа", Тип("ГруппаФормы"), ЭтотОбъект, Элементы.Страницы);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Заголовок = "Скидка";
	
	ПолеРеквизита1 = Элементы.Добавить("Дор_СогласованнаяСкидка", Тип("ПолеФормы"), НоваяГруппа);
	ПолеРеквизита1.Вид = ВидПоляФормы.ПолеВвода;
	ПолеРеквизита1.Заголовок = "Согласовано";
	ПолеРеквизита1.ПутьКДанным = "Объект.Дор_СогласованнаяСкидка";
	
	ПолеРеквизита2 = Элементы.Добавить("КомандаПересчитатьСУчетомСкидки", Тип("КнопкаФормы"), НоваяГруппа);
	ПолеРеквизита2.ИмяКоманды = "Дор_ПересчитатьСУчетомСкидки";
	ПолеРеквизита2.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	
	Элементы.Дор_СогласованнаяСкидка.УстановитьДействие("ПриИзменении", "Дор_СогласованнаяСкидкаПриИзменении")
	//--- Макаренко В.П. 25.01.2026
	
КонецПроцедуры

