#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//Версия 1.0.1.1
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
	//++ Зиедс 07.12.25
	//Суммирование скидок
	СуммаСкидок = Объект.Скидка+ТекущиеДанные.Скидка;
	Если СуммаСкидок > 100 Тогда
		Сообщить(СтрШаблон("Сумма скидок по %1 превышает 100%", ТекущиеДанные.Номенклатура));
		ТекущиеДанные.Сумма = 0;
	Иначе
		ТекущиеДанные.Сумма = ТекущиеДанные.Количество * (ТекущиеДанные.Цена - ТекущиеДанные.Цена * СуммаСкидок/100);
	КонецЕсли;
	//--Зиедс 07.12.25
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

