//++ СтудентНетология Зозуля Т.В. 27.01.2026 Доработка расчета суммы документа ДЗ_13_2
&НаКлиенте
Процедура Подключаемый_ДЗ_13_2_ПересчитатьСуммуСоСкидкой(Команда)
	ДЗ11_2_РассчитатьСуммуТаблиц();
КонецПроцедуры

&НаКлиенте
Асинх Процедура Подключаемый_ДЗ_13_2_СогласованнаяСкидкаПриИзменении(ТекущиеДанные)

	Если ЗначениеЗаполнено(Объект.Товары) Или ЗначениеЗаполнено(Объект.Услуги) Тогда
		Ответ = Ждать ВопросАсинх("Процент скидки изменен. Пересчитать таблицу Товары и Услуги?",
		РежимДиалогаВопрос.ДаНет);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ДЗ_13_2_РассчитатьСуммуТаблиц();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
//-- СтудентНетология Зозуля Т.В. 27.01.2026

