
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Начало Иванова А Ю 07.08.2026 ДЗ Задача 1. «Добавление объектов метаданных в конфигурацию, стоящую на поддержке»
	СозданиеЭлементов.ДополнитьФорму(ЭтотОбъект);
	// Конец Иванова А Ю 07.08.2026
	
	// Начало Иванова А Ю 07.08.2026 ДЗ Задача 2. «Доработка программного кода в Конфигурации»
	//Создаем группу реквизит и кнопку
	Группа = Элементы.Вставить("СкидкаКнопка", Тип("ГруппаФормы"),,Элементы.Страницы);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = "Скидка кнопка";

	НовыеРеквизиты = Новый Массив;
	ТипРеквизита = Новый ОписаниеТипов("Число");
	Знак = ДопустимыйЗнак.Неотрицательный;
	ПараметрыЧисла = Новый КвалификаторыЧисла(10, 2, Знак);
	РеквизитДССогласованнаяСкидка = Новый РеквизитФормы("ДССогласованнаяСкидка", ТипРеквизита, "", "Согласованная скидка");
	НовыеРеквизиты.Добавить(РеквизитДССогласованнаяСкидка);
	ПолеВвода = Элементы.Вставить("СогласованнаяСкидка", Тип("ПолеФормы"),, Элементы.Страницы);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.ДССогласованнаяСкидка";
	ПолеВвода.УстановитьДействие("ПриИзменении", "ПриИзмененииСогласованнойСкидки");
	
	Команда = Команды.Добавить("ПересчитатьТаблицы");
	Команда.Заголовок = "Пересчитать таблицы";
	Команда.Действие = "КомандаПересчитатьТаблицы";
	
	КнопкаФормы = Элементы.Вставить("КнопкаПересчитатьТаблицы", Тип("КнопкаФормы"),,Элементы.Страницы);
	КнопкаФормы.ИмяКоманды = "ПересчитатьТаблицы";
	КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	// Конец Иванова А Ю 07.08.2026
	
КонецПроцедуры

