#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//Начало Иванова 07.08.2026 ДЗ Задача 2. «Доработка программного кода в Конфигурации»
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * (ТекущиеДанные.Цена - ТекущиеДанные.Цена * Объект.ДССогласованнаяСкидка/100);
	
	РассчитатьСуммуДокумента();
	// Конец Иванова 07.08.2026
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПриИзмененииСогласованнойСкидки(Элемент)
	// Начало Иванова А Ю 07.08.2026 ДЗ Задача 2. «Доработка программного кода в Конфигурации»
	
	// Если обе табличные части пусты, пересчитывать нечего.
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Показываем вопрос пользователю.
	ТекстВопроса = "Будет выполнен полный пересчет всех строк в табличных частях ""Товары"" и ""Услуги""." + Символы.ПС + "Продолжить?";
	
	ОтветНаВопрос = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
	// Выполняем пересчет только если пользователь нажал "Да"
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		РасчитатьТаблицу();
	КонецЕсли; 
	
	// Пересчитываем итоговую сумму документа независимо от ответа пользователя,
	// так как изменение скидки напрямую влияет на неё.
	РассчитатьСуммуДокумента();
	
	// Конец Иванова А Ю 07.08.2026

КонецПроцедуры

&НаКлиенте
Процедура КомандаПересчитатьТаблицы(Команда)
	// Начало Иванова А Ю 07.08.2026 ДЗ Задача 2. «Доработка программного кода в Конфигурации»
	// ДействиеКоманды
	РасчитатьТаблицу();
	РассчитатьСуммуДокумента();
	// Конец Иванова А Ю 07.08.2026
	
КонецПроцедуры

&НаКлиенте
Процедура РасчитатьТаблицу()
	// Начало Иванова А Ю 07.08.2026 ДЗ Задача 2. «Доработка программного кода в Конфигурации»
	//Расчитываем таблицы Товары и Услуги
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		
		РассчитатьСуммуСтроки(СтрокаТЧ);
		
	КонецЦикла;
	
	Для Каждого СтрокаТЧ Из Объект.Услуги Цикл
		
		РассчитатьСуммуСтроки(СтрокаТЧ);
		
	КонецЦикла;
	// Конец Иванова А Ю 07.08.2026
КонецПроцедуры 


