
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	 
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//++ Хафизова А.А. 27.06.2026
	// Добавление КонтактноеЛицо, СогласованнаяСкидка, ПересчитатьТаблицу
	
	ГруппаЛево = Элементы.Найти("ГруппаШапкаЛево");
	ГруппаПраво = Элементы.Найти("ГруппаШапкаПраво"); 
	
	ГруппаСкидки = Элементы.Найти("ГруппаСкидка");
	ГруппаСкидки = Элементы.Добавить("ГруппаСкидка", Тип("ГруппаФормы"), ГруппаЛево);
	ГруппаСкидки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСкидки.Заголовок = "Скидка";
	ГруппаСкидки.ОтображатьЗаголовок = Ложь;
	ГруппаСкидки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаСкидки.РастягиватьПоГоризонтали = Истина;
			
	ТипРеквизитаКонтактноеЛицо = Новый ОписаниеТипов("СправочникСсылка.ДЗ_КонтактныеЛица");
	ТипРеквизитаСкидка = Новый ОписаниеТипов("Число");
	ДобавляемыеРеквизиты = Новый Массив;
	
	РеквизитФормыКонтактноеЛицо = Новый РеквизитФормы("ДЗ_КонтактноеЛицо", ТипРеквизитаКонтактноеЛицо, "", "Контактное лицо");
	РеквизитФормыСогласованнаяСкидка = Новый РеквизитФормы("ДЗ_СогласованнаяСкидка", ТипРеквизитаСкидка, "", "Согласованная скидка, %");

	ДобавляемыеРеквизиты.Добавить(РеквизитФормыКонтактноеЛицо);
	ДобавляемыеРеквизиты.Добавить(РеквизитФормыСогласованнаяСкидка);
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	НовыйЭлементКонтактноеЛицо = Элементы.Добавить("КонтактноеЛицо", Тип("ПолеФормы"), ГруппаПраво);
	НовыйЭлементКонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлементКонтактноеЛицо.ПутьКДанным = "Объект.ДЗ_КонтактноеЛицо"; 
	Элементы.Переместить(НовыйЭлементКонтактноеЛицо, ГруппаПраво, Элементы.Найти("Договор"));
	
	НовыйЭлементСогласованнаяСкидка = Элементы.Добавить("СогласованнаяСкидка", Тип("ПолеФормы"), ГруппаСкидки);
	НовыйЭлементСогласованнаяСкидка.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлементСогласованнаяСкидка.ПутьКДанным = "Объект.ДЗ_СогласованнаяСкидка";
	НовыйЭлементСогласованнаяСкидка.УстановитьДействие("ПриИзменении", "ДЗ_СогласованнаяСкидкаПриИзменении");
	
	Команда = Команды.Добавить("ДЗ_ПересчитатьТаблицу");
	Команда.Заголовок = "Пересчитать таблицу";
	Команда.Картинка = БиблиотекаКартинок.Обновить;
	Команда.Действие = "ДЗ_ПересчитатьТаблицу";
	
	НоваяКнопка = Элементы.Добавить("КнопкаПересчитатьТаблицу", Тип("КнопкаФормы"), ГруппаСкидки);
	НоваяКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	НоваяКнопка.ИмяКоманды = "ДЗ_ПересчитатьТаблицу";
	//-- Хафизова А.А.
	
КонецПроцедуры

