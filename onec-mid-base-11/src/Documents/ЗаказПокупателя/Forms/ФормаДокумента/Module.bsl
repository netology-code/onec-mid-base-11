#Область СлужебныеПроцедурыИФункции

// ++ Крымов "ДЗ №13.1" 20.11.2026
&НаКлиенте
Процедура ЗавершениеВопросаОСкидке(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПрименитьСкидкуДляВсегоДокумента();
	КонецЕсли;
	
КонецПроцедуры
// -- Крымов "ДЗ №13.1" 20.11.2026

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
// ++ Крымов "ДЗ №13.1" 20.11.2026	
	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	СуммаСкидок = ТекущиеДанные.Скидка + Объект.ДЗ13_СогласованнаяСкидка;
	Если СуммаСкидок > 100 Тогда
		Текст = СтрШаблон( "Сумма скидок для ""%1"" превышает 100%%", ТекущиеДанные.Номенклатура );
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст);
		СуммаСкидок = 100;
	КонецЕсли;
	КоэффициентСкидки = 1 - СуммаСкидок / 100;
// -- Крымов "ДЗ №13.1" 20.11.2026	
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

#Область ПодключаемыеКоманды

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
    ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
    ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
    ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

// ++ Крымов "ДЗ №13.1" 20.11.2026
&НаКлиенте
Процедура ПрименитьСкидкуДляВсегоДокумента()

	Для Каждого Товар Из Объект.Товары Цикл
		РассчитатьСуммуСтроки( Товар );
	КонецЦикла;
	
	Для Каждого Услуга Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки( Услуга );
	КонецЦикла;

КонецПроцедуры



#КонецОбласти

#КонецОбласти
