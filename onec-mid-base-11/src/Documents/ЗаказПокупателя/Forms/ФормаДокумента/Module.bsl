#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ++ Вихарев А.А. 03.10.2026
	// Проверяем, не добавлено ли поле и группа ранее (чтобы избежать дублирования)
	Если (Элементы.Найти("ДК_КонтактноеЛицо") = Неопределено) И (Элементы.ГруппаШапкаПраво <> Неопределено) Тогда
		
		// Создаём поле ввода для реквизита "ДК_КонтактныеЛица"
		ПолеДК_КонтактныеЛица = Элементы.Добавить("ДК_КонтактноеЛицо", Тип("ПолеФормы"), Элементы.ГруппаШапкаПраво);
		ПолеДК_КонтактныеЛица.Вид = ВидПоляФормы.ПолеВвода;
		ПолеДК_КонтактныеЛица.ПутьКДанным = "Объект.ДК_КонтактноеЛицо";
		ПолеДК_КонтактныеЛица.Заголовок = "Контактное лицо";
		
		// Ограничиваем выбор Контактных лиц
		МассивСвязей = Новый Массив;
		НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.Контрагент");
		МассивСвязей.Добавить(НоваяСвязь);
		ПолеДК_КонтактныеЛица.СвязиПараметровВыбора = Новый ФиксированныйМассив(МассивСвязей);
	КонецЕсли;
			
	// Проверяем, не добавлено ли группа, поле и команда ранее (чтобы избежать дублирования)
	Если (Элементы.Найти("ДК_ГруппаСкидка") = Неопределено) И (Элементы.Найти("ДК_СогласованнаяСкидкаПоле")
		= Неопределено) И (Элементы.Найти("ДК_ПрименитьСкидкуКоманда") = Неопределено) Тогда
		
		// Создаём группу "ДК_ГруппаСкидка" (обычная группа)
		ДК_СкидкаГруппа = Элементы.Добавить("ДК_ГруппаСкидка", Тип("ГруппаФормы"));
		ДК_СкидкаГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ДК_СкидкаГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
		ДК_СкидкаГруппа.ОтображатьЗаголовок = Ложь;
		
		// Добавляем поле для ввода скидки, помещаем внутрь созданной группы
		ДК_СогласованнаяСкидкаПоле = Элементы.Добавить("ДК_СогласованнаяСкидка", Тип("ПолеФормы"), ДК_СкидкаГруппа);
		ДК_СогласованнаяСкидкаПоле.Вид = ВидПоляФормы.ПолеВвода;
		ДК_СогласованнаяСкидкаПоле.Заголовок = "Согласованная скидка (ДК)";
		ДК_СогласованнаяСкидкаПоле.ПутьКДанным = "Объект.ДК_СогласованнаяСкидка";
		Элементы.Переместить(ДК_СкидкаГруппа, ЭтотОбъект, Элементы.Страницы);
		ДК_СогласованнаяСкидкаПоле.УстановитьДействие("ПриИзменении", "ДК_СкидкаПриИзменении");
		
		// Создаем команду формы ПрименитьСкидку
		ДК_ПрименитьСкидкуКоманда = Команды.Добавить("ДК_ПрименитьСкидку");
		ДК_ПрименитьСкидкуКоманда.Заголовок = "Применить скидку";
		ДК_ПрименитьСкидкуКоманда.Действие = "ДК_ПрименитьСкидку";
		ДК_ПрименитьСкидкуКоманда.Картинка = БиблиотекаКартинок.Успешно;
		ДК_ПрименитьСкидкуКоманда.Отображение = ОтображениеКнопки.КартинкаИТекст;
		
		// Создаем кнопку ПрименитьСкидку и связываем с командой ПрименитьСкидку
		ДК_ПрименитьСкидкуКнопка = Элементы.Добавить("ДК_ПрименитьСкидку", Тип("КнопкаФормы"), ДК_СкидкаГруппа);
		ДК_ПрименитьСкидкуКнопка.ИмяКоманды = "ДК_ПрименитьСкидку";
		ДК_ПрименитьСкидкуКнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КонецЕсли;
	
	// -- Вихарев А.А. 03.10.2026
КонецПроцедуры

