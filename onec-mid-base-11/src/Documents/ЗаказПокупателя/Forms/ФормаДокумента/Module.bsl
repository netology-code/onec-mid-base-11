
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Плиев А.Н создадим группу в форме и добавим в ее наши созданные реквизиты  ПересчитатьТаблицу и ДЗ_СогласованнаяСкидка
	
	ГруппаДополнений =Элементы.Добавить("ГруппаДополнений", Тип("ГруппаФормы"));
	
	ГруппаДополнений.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	
	ГруппаДополнений.Заголовок = "";
	
	ГруппаДополнений.ОтображатьЗаголовок = Ложь;
	
	ГруппаДополнений.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	Элементы.Переместить(ГруппаДополнений,Элементы.ГруппаКолонкиШапки.Родитель,Элементы.Страницы);
	
	// Плиев А.Н выведем его на форму ДЗ_СогласованнаяСкидка
	ЭлементДЗ_КонтактноеЛицо = Элементы.Добавить("ДЗ_КонтактноеЛицо", Тип("ПолеФормы"),Элементы.ГруппаШапкаПраво);  
	
	ЭлементДЗ_КонтактноеЛицо.ПутьКДанным = "Объект.ДЗ_КонтактноеЛицо";
	
	ЭлементДЗ_КонтактноеЛицо.Вид  = ВидПоляФормы.ПолеВвода;
	
	// Плиев А.Н выведем его на форму ДЗ_СогласованнаяСкидка
	ЭлементДЗ_СогласованнаяСкидка = Элементы.Добавить("ДЗ_СогласованнаяСкидка", Тип("ПолеФормы"),Элементы.ГруппаДополнений);  
	
	ЭлементДЗ_СогласованнаяСкидка.ПутьКДанным = "Объект.ДЗ_СогласованнаяСкидка";
	
	ЭлементДЗ_СогласованнаяСкидка.Вид  = ВидПоляФормы.ПолеВвода;
	
	ЭлементДЗ_СогласованнаяСкидка.УстановитьДействие("ПриИзменении", "ДЗ_СогласованнаяСкидкаПриИзменении"); 
	
	
	// Плиев А.Н Создание команды
	НоваяКоманда = Команды.Добавить("ПересчитатьТаблицу");
	НоваяКоманда.Заголовок = "Пересчитать Таблицу";
	НоваяКоманда.Действие = "ДЗ_СогласованнаяСкидкаПриИзменении()"; //указываем только имя процедуры
	
	
	//Создание кнопок	
	// Плиев А.Н выведем его на форму кнопку ПересчитатьТаблицу
	НовыйЭлемент = Элементы.Добавить("Кнопка1", Тип("КнопкаФормы"),Элементы.ГруппаДополнений);
	НовыйЭлемент.Заголовок = "Пересчитать Таблицу";
	НовыйЭлемент.ИмяКоманды = "ПересчитатьТаблицу";
	
КонецПроцедуры

