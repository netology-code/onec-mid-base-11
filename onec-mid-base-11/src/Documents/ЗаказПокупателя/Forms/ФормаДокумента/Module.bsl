
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//++ Борисенко Д.С. 21.07.2006
	
	ЭлементКонтактноеЛицо = Элементы.Вставить("ДБ_КонтактноеЛицо", Тип("ПолеФормы"), Элементы.ГруппаШапкаПраво);
	ЭлементКонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементКонтактноеЛицо.ПутьКДанным = "Объект.ДБ_КонтактноеЛицо";
	
	//@skip-check org.eclipse.xtext.diagnostics.Diagnostic.Syntax
	ГруппаСкидка = Элементы.Вставить("ГруппаСкидка", Тип("ГруппаФормы"), Элементы.ГруппаШапкаЛево);
	ГруппаСкидка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСкидка.Отображение = ОтображениеОбычнойГруппы.Нет ;   
	ГруппаСкидка.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Авто ;      
	
	ЭлементСогласованнаяСкидка = Элементы.Вставить("СогласованнаяСкидка", Тип("ПолеФормы"), Элементы.ГруппаСкидка);
	ЭлементСогласованнаяСкидка.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементСогласованнаяСкидка.ПутьКДанным = "Объект.СогласованнаяСкидка"; 
	ЭлементСогласованнаяСкидка.УстановитьДействие("ПриИзменении", "ПриИзмененииСогласованнаяСкидка");
		
	//@skip-check module-self-reference
	КомандаПересчетТЧ = ЭтотОбъект.Команды.Добавить("Пересчет");
	КомандаПересчетТЧ.Действие = "ПересчетТабличнойЧастиКоманда";
	КомандаПересчетТЧ.Заголовок = "Пересчет";

	//@skip-check module-self-reference
	КнопкаПересчетТЧ = ЭтотОбъект.Элементы.Добавить("Пересчет", Тип("КнопкаФормы"), Элементы.ГруппаСкидка);
	КнопкаПересчетТЧ.ИмяКоманды = "Пересчет";
	
	//-- Борисенко Д.С. 21.07.2006
	
	
КонецПроцедуры

