КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура ПересчитатьСУчетомСкидки(Команда)
	
	//+++ Макаренко В.П. 25.01.2026
	Если Объект.Товары.Количество() > 0 ИЛИ Объект.Услуги.Количество() > 0 Тогда
		ПересчитатьТЧ();
	Иначе
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ("Товары и услуги отсутствуют в документе");
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

