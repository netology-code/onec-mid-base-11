//++Варламов 22.04.2026
// Проверка превышения максимальной скидки (99%) при изменении согласованной скидки
// и запрос подтверждения пересчета сумм документа
//
&НаКлиенте
Процедура Подключаемый_ТД_СогласованнаяСкидкаПриИзменении(Элемент)

	ТаблицаНеПустая = Объект.Товары.Количество() > 0 ИЛИ Объект.Услуги.Количество() > 0;

      // Проверка на превышение максимальной скидки
      Если ТаблицаНеПустая Тогда

          ЕстьПревышение = Ложь;

          Для Каждого СтрокаТовара Из Объект.Товары Цикл
              Если Объект.ТД_СогласованнаяСкидка + СтрокаТовара.Скидка > 99 Тогда
                  ЕстьПревышение = Истина;
                  Прервать;
              КонецЕсли;
          КонецЦикла;

          Если НЕ ЕстьПревышение Тогда
              Для Каждого СтрокаУслуги Из Объект.Услуги Цикл
                  Если Объект.ТД_СогласованнаяСкидка + СтрокаУслуги.Скидка > 99 Тогда
                      ЕстьПревышение = Истина;
                      Прервать;
                  КонецЕсли;
              КонецЦикла;
		  КонецЕсли;
		  
		  ОписаниеОповещения = Новый ОписаниеОповещения(
		  "ТД_СогласованнаяСкидкаПриИзмененииЗавершение", ЭтотОбъект, ЕстьПревышение);
		  
		  ПоказатьВопрос(ОписаниеОповещения,
		  "Пересчитать суммы в табличных частях с учётом новой скидки?",
		  РежимДиалогаВопрос.ДаНет);
		  
	  КонецЕсли;

КонецПроцедуры
//--Варламов 20.02.2026

#КонецОбласти

