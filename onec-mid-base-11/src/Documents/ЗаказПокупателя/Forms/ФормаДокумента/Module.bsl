&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	
	// ++ Татьяна: пересчет суммы с учетом скидки

	//ДЗ к занятию "Командная работа (EDT)" 06.10.26  
	
  //Исходный код:	
    //КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
 //Новый код:
 	СуммаСкидок = Объект.СИБ_СогласованнаяСкидка +  ТекущиеДанные.Скидка;    
	Если СуммаСкидок >100 Тогда
		СуммаСкидок = 100;
		Сообщить("Сумма скидок не должна превышать 100%");
	КонецЕсли;
	
	КоэффициентСкидки = 1 - СуммаСкидок / 100;
	ТекущиеДанные.Сумма =  ТекущиеДанные.Количество * ТекущиеДанные.Цена * КоэффициентСкидки;
	РассчитатьСуммуДокумента();  
 	
	// -- Татьяна: пересчет суммы с учетом скидки 06.10.26
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

