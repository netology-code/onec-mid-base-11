#Область СлужебныеПроцедурыИФункции

//Начало СмоленцевВА 12.04.2026
&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//Удалён код для расчёта суммы строки
	// Расчет суммы с учетом скидки из шапки документа
	БазоваяСумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	ТекущиеДанные.Сумма = БазоваяСумма * (1 - Объект.ДЗ_СогласованнаяСкидка / 100);
	
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДЗ_СогласованнаяСкидкаПриИзменении(Элемент)
	
	// Проверяем, что табличные части не пустые
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Вопрос = ВопросАсинх("Изменен процент скидки. Пересчитать таблицу товаров и услуг?", РежимДиалогаВопрос.ДаНет);
	ОтветНаВопрос = Ждать Вопрос;
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ДЗ_ПересчитатьВсеТаблицы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_ПересчитатьВсеТаблицы()
	
	// Пересчет товаров
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(СтрокаТовара);
	КонецЦикла;
	
	// Пересчет услуг
	Для Каждого СтрокаУслуги Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(СтрокаУслуги);
	КонецЦикла;
	
	// Обновление итогов документа
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТаблицу(Команда)
	
	ДЗ_ПересчитатьВсеТаблицы();
	
КонецПроцедуры
//Конец СмоленцевВА 12.04.2026

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

