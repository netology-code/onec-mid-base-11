//+ 07.12.25 Зиедс
&НаКлиенте
Асинх Процедура СкидкаПриИзменении(Элемент)
	
Если ЗначениеЗаполнено(Объект.Товары) ИЛИ ЗначениеЗаполнено(Объект.Услуги) Тогда
	Вопрос = ВопросАсинх("Изменен процент скидки. Пересчитать таблицу товаров и услуг?", РежимДиалогаВопрос.ДаНет);
	ОтветНаВопрос = Ждать Вопрос;
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ПересчитатьТаблицы();
	КонецЕсли;
КонецЕсли;

КонецПроцедуры
//- 07.12.25 Зиедс

//+ 07.12.25 Зиедс
&НаКлиенте
Процедура ПересчитатьТаблицы()
	
	Для Каждого СтрокаТаблицы Из объект.Товары Цикл
		РассчитатьСуммуСтроки(СтрокаТаблицы);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(СтрокаТаблицы);
	КонецЦикла;
	
	РассчитатьСуммуДокумента();
	
КонецПроцедуры
//- 07.12.25 Зиедс
#КонецОбласти

