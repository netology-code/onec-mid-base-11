		КонецЦикла;
		
		//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
		
		// Заполнение шапки
		Договор = ВыборкаДетальныеЗаписи.Договор; //ДанныеЗаполнения.Договор;
		Комментарий = ВыборкаДетальныеЗаписи.Комментарий;//ДанныеЗаполнения.Комментарий;
		Контрагент = ВыборкаДетальныеЗаписи.Контрагент;//ДанныеЗаполнения.Контрагент;
		Организация = ВыборкаДетальныеЗаписи.Организация;//ДанныеЗаполнения.Организация;
		Ответственный = ВыборкаДетальныеЗаписи.Ответственный;//ДанныеЗаполнения.Ответственный;
		Основание = ВыборкаДетальныеЗаписи.Ссылка;// ДанныеЗаполнения.Ссылка;
		
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

