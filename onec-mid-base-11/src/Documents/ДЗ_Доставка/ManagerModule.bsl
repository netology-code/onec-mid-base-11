Процедура ПриОпределенииНастроекПечати(НастройкиОбъекта) Экспорт	
	НастройкиОбъекта.ПриДобавленииКомандПечати = Истина;
КонецПроцедуры

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Анкеты клиента
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "АнкетыКлиента";
	КомандаПечати.Представление = НСтр("ru = 'Анкеты клиента'");
	КомандаПечати.Порядок = 50;

	// Траспортной накладной
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ТраспортнойНакладной";
	КомандаПечати.Представление = НСтр("ru = 'Траспортной накладной'");
	КомандаПечати.Порядок = 60; 
	
	// Комплект документов
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "АнкетыКлиента,ТраспортнойНакладной";
	КомандаПечати.Представление = НСтр("ru = 'Комплект документов'");
	КомандаПечати.Порядок = 70;
	
	// Договор на доставку    //Когда добовляем Макет в пользовательском режиме
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "УправлениеПечатью";
	КомандаПечати.Идентификатор = "Документ.ДЗ_Доставка.ПФ_DOC_ДоговорНаДоставку";
	КомандаПечати.Представление = НСтр("ru = 'Договор на доставку DOCX'");
	КомандаПечати.Порядок = 61;

	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "АнкетыКлиента");
	Если ПечатнаяФорма <> Неопределено Тогда
	    ПечатнаяФорма.ТабличныйДокумент = ПечатьАнкетыКлиента(МассивОбъектов, ОбъектыПечати);
	    ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Анкеты клиента'");
	    ПечатнаяФорма.ПолныйПутьКМакету = "Документ.ДЗ_Доставка.ПФ_MXL_АнкетыКлиента";
	КонецЕсли; 
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "ТраспортнойНакладной");
	Если ПечатнаяФорма <> Неопределено Тогда
	    ПечатнаяФорма.ТабличныйДокумент = ПечатьТраспортнойНакладной(МассивОбъектов, ОбъектыПечати);
	    ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Траспортной накладной'");
	    ПечатнаяФорма.ПолныйПутьКМакету = "Документ.ДЗ_Доставка.ПФ_MXL_ТраспортнойНакладной";
	КонецЕсли;

КонецПроцедуры

Функция ПечатьАнкетыКлиента(МассивОбъектов, ОбъектыПечати) Экспорт
	// Плиев 24.07.2026
	
	//сформируем табличный документ
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПараметрыПечати_АнкетыКлиента";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ДЗ_Доставка.ПФ_MXL_АнкетыКлиента");
	
	//собрать данные
	
	ДанныеДокументов = ПолучитьДанныеДокументов(МассивОбъектов);
	
	//печать
	
	ПервыйДокумент = Истина;
	
	Пока ДанныеДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		//шапка
		ВывестиЗаголовок(ДанныеДокументов, ТабличныйДокумент, Макет);  // Выводим Заголовак
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		НомерСтрокиНачало, ОбъектыПечати, ДанныеДокументов.Ссылка);		
		
	КонецЦикла;
	//подвал
	Возврат ТабличныйДокумент;
	
	// Плиев 24.07.2026
КонецФункции 

Функция ПечатьТраспортнойНакладной(МассивОбъектов, ОбъектыПечати) Экспорт
	// Плиев 24.07.2026
	
	//сформируем табличный документ
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПараметрыПечати_ТраспортнойНакладной";
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ДЗ_Доставка.ПФ_MXL_ТраспортнойНакладной");
	
	//собрать данные
	
	ДанныеДокументов = ПолучитьДанныеДокументов(МассивОбъектов);
	
	//печать
	
	ПервыйДокумент = Истина;
	
	Пока ДанныеДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		//шапка
		ВывестиЗаголовок(ДанныеДокументов, ТабличныйДокумент, Макет);  // Выводим Заголовак
		
		ВывестиТоварШапка(ДанныеДокументов, ТабличныйДокумент, Макет);  // Выводим Заголовак
		
		ВывестиКомментарий(ДанныеДокументов, ТабличныйДокумент, Макет);  // Выводим Заголовак
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		НомерСтрокиНачало, ОбъектыПечати, ДанныеДокументов.Ссылка);		
		
	КонецЦикла;
	//подвал
	Возврат ТабличныйДокумент;
	
	// Плиев 24.07.2026
КонецФункции 

Функция ПолучитьДанныеДокументов(МассивОбъектов)
	// Плиев 27.07.2026
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДЗ_Доставка.Ссылка КАК Ссылка,
	|	ДЗ_Доставка.Номер КАК Номер,
	|	ДЗ_Доставка.Дата КАК Дата,
	|	ДЗ_Доставка.Организация КАК Организация,
	|	ДЗ_Доставка.Контрагент КАК Контрагент,
	|	ДЗ_Доставка.Договор КАК Договор,
	|	ДЗ_Доставка.Ответственный КАК Ответственный,
	|	ДЗ_Доставка.Товары.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Номенклатура КАК Номенклатура,
	|		Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|		Количество КАК Количество
	|	) КАК Товары
	|ИЗ
	|	Документ.ДЗ_Доставка КАК ДЗ_Доставка
	|ГДЕ
	|	ДЗ_Доставка.Ссылка В(&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Возврат Запрос.Выполнить().Выбрать();
	// Плиев 27.07.2026
КонецФункции

 Процедура ВывестиЗаголовок(ДанныеДокументов, ТабличныйДокумент, Макет)
	 // Плиев 27.07.2026
	 //Выводим Заголовок 
	 
	 ОбластьЗаголовокДокумента = Макет.ПолучитьОбласть("Заголовок");
	 
	 ДанныеПечати = Новый Структура;
	 ДанныеПечати.Вставить("ПредставлениеПолучателя", ДанныеДокументов.Контрагент);
	 
	 ШаблонЗаголовка = "Траспортной накладной %1 от %2";
	 ТекстЗаголовка = СтрШаблон(ШаблонЗаголовка,
	 ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеДокументов.Номер),
	 Формат(ДанныеДокументов.Дата, "ДЛФ=DD"));
	 ДанныеПечати.Вставить("ТекстЗаголовка", ТекстЗаголовка);
	 ДанныеПечати.Вставить("Организация", ДанныеДокументов.Организация);
	 ДанныеПечати.Вставить("Контрагент", ДанныеДокументов.Контрагент);
	 
	 ОбластьЗаголовокДокумента.Параметры.Заполнить(ДанныеПечати);
	 //QR
	 СсылкаНаДокумент = ПолучитьНавигационнуюСсылку(ДанныеДокументов.Ссылка);
	 
	 ДанныеQRКода = ГенерацияШтрихкода.ДанныеQRКода(СсылкаНаДокумент, 1, 120);
	 
	 Если НЕ ТипЗнч(ДанныеQRКода) = Тип("ДвоичныеДанные") Тогда
		 ТекстСообщения = НСтр("ru = 'Не удалось сформировать QR-код.
		 |Технические подробности см. в журнале регистрации.'");
		 ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	 Иначе
		 КартинкаQRКода = Новый Картинка(ДанныеQRКода);
		 ОбластьЗаголовокДокумента.Рисунки.QRКод.Картинка = КартинкаQRКода;
	 КонецЕсли;		
	 //QR
	 ТабличныйДокумент.Вывести(ОбластьЗаголовокДокумента);
	 // Плиев 27.07.2026
КонецПроцедуры

Процедура ВывестиТоварШапка(ДанныеДокументов, ТабличныйДокумент, Макет)
	 // Плиев 27.07.2026
	 //Выводим Заголовок 
	 
	 ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ТоварШапка");
	 //ОбластьШапкаСтроки = Макет.ПолучитьОбласть("ТоварСтрока");
	 ОбластьСтрока =  Макет.ПолучитьОбласть("ТоварСтрока");
	 
	 ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	ВыборкаТовары = ДанныеДокументов.Товары.Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл
		ОбластьСтрока.Параметры.Заполнить(ВыборкаТовары);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	
	// Плиев 27.07.2026
КонецПроцедуры

Процедура ВывестиКомментарий(ДанныеДокументов, ТабличныйДокумент, Макет)
	 // Плиев 27.07.2026
	 //Выводим Заголовок 
	 
	 ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("Комментарий");
	 
	 //ОбластьСтрока =  Макет.ПолучитьОбласть("ТоварСтрока");
	 
	 ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	 
	 // Плиев 27.07.2026
КонецПроцедуры

