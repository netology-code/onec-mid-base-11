#Область ПрограммныйИнтерфейс
Процедура ДополнитьФорму(Форма) Экспорт
	
	// ++ Хоменко В.И. 22.01.26
	
	ИмяФормы = Форма.ИмяФормы;
	
	Если ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаДокумента" Тогда
		ДобавитьПолеД_КонтактноеЛицоВГруппаШапкаПраво(Форма);
	ИначеЕсли ИмяФормы = "Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокумента" Тогда
		ДобавитьПолеД_КонтактноеЛицоВГруппаШапкаПраво(Форма);
	ИначеЕсли ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
		ДобавитьПолеД_КонтактноеЛицоВГруппаШапкаПраво(Форма);
	ИначеЕсли ИмяФормы = "Документ.ОплатаОтПокупателя.Форма.ФормаДокумента" Тогда
		ДобавитьПолеД_КонтактноеЛицоПередСуммаДокумента(Форма);
	ИначеЕсли ИмяФормы = "Документ.ОплатаПоставщику.Форма.ФормаДокумента" Тогда
		ДобавитьПолеД_КонтактноеЛицоПередСуммаДокумента(Форма);
	КонецЕсли;
	
	Если ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаДокумента" Тогда
		ДобавитьПолеИКомандуВЗаказПокупателя(Форма);
	КонецЕсли;
	
	//-- Хоменко В.И. 22.01.26
 
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПолеД_КонтактноеЛицоВГруппаШапкаПраво(Форма)
	//++ Хоменко В.И. 22.01.26
	ПолеВвода = Форма.Элементы.Добавить("Д_КонтактноеЛицо", Тип("ПолеФормы"), Форма.Элементы.ГруппаШапкаПраво);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.Д_КонтактноеЛицо";		
	//-- Хоменко В.И. 22.01.26
КонецПроцедуры

Процедура ДобавитьПолеД_КонтактноеЛицоПередСуммаДокумента(Форма)
	//++ Хоменко В.И. 22.01.26
	ПолеВвода = Форма.Элементы.Вставить("Д_КонтактноеЛицо", Тип("ПолеФормы"), ,Форма.Элементы.СуммаДокумента);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.Д_КонтактноеЛицо";	
	//-- Хоменко В.И. 22.01.26
КонецПроцедуры

Процедура ДобавитьПолеИКомандуВЗаказПокупателя(Форма)
	//++ Хоменко В.И. 22.01.26
	Группа = Форма.Элементы.Добавить("ГруппаСогласованнаяСкидка", Тип("ГруппаФормы"), Форма.Элементы.ГруппаШапкаЛево);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	Группа.ОтображатьЗаголовок = ЛОЖЬ;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	ПолеВвода = Форма.Элементы.Добавить("Д_СогласованнаяСкидка", Тип("ПолеФормы"), Группа);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.Д_СогласованнаяСкидка";
	ПолеВвода.УстановитьДействие("ПриИзменении", "Д_СогласованнаяСкидкаПриИзменении");
	
	Если Форма.Элементы.Найти("КнопкаКоманды") = Неопределено Тогда
	Команда = Форма.Команды.Добавить("ПересчитатьСкидку");
	Команда.Заголовок = "ПересчитатьСкидку";
	Команда.Действие = "Д_ПересчитатьСкидку";
	
	КнопкаКоманды = Форма.Элементы.Добавить("ПересчитатьСкидку", Тип("КнопкаФормы"), Группа);
	КнопкаКоманды.ИмяКоманды = "ПересчитатьСкидку";
	КнопкаКоманды.Заголовок = "ПересчитатьСкидку";
	КнопкаКоманды.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
    КонецЕсли;

	//-- Хоменко В.И. 22.01.26
КонецПроцедуры
#КонецОбласти