
#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьРеквизит(Форма) Экспорт
	
	Имя = Форма.ИмяФормы;
	ЧастиИмени = СтрРазделить(Имя, ".", Ложь);
	
	Если ЧастиИмени[ЧастиИмени.ВГраница()] <> "ФормаДокумента" Тогда
		Возврат;
	КонецЕсли; 
	
	Если ЧастиИмени[1] = "ОплатаОтПокупателя" Тогда
		ПолеРеквизита = Форма.Элементы.Вставить("КонтактноеЛицо", Тип("ПолеФормы"), Форма, Форма.Элементы.Основание);
	ИначеЕсли ЧастиИмени[1] = "ОплатаПоставщику" Тогда
		ПолеРеквизита = Форма.Элементы.Вставить("КонтактноеЛицо", Тип("ПолеФормы"), Форма, Форма.Элементы.СуммаДокумента);
	ИначеЕсли ЧастиИмени[1] = "Дор_Доставка" Тогда
		ПолеРеквизита = Форма.Элементы.Вставить("КонтактноеЛицо", Тип("ПолеФормы"), Форма, Форма.Элементы.Товары);	
	Иначе
		ПолеРеквизита = Форма.Элементы.Вставить("КонтактноеЛицо", Тип("ПолеФормы"), Форма, Форма.Элементы.Страницы);
	КонецЕсли;

	ПолеРеквизита.Вид = ВидПоляФормы.ПолеВвода;
	ПолеРеквизита.Заголовок = "Контактное лицо";
	ПолеРеквизита.ПутьКДанным = "Объект.Дор_КонтактноеЛицо";
			
КонецПроцедуры

#КонецОбласти