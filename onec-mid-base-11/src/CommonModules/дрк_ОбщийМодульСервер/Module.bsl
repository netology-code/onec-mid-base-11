// дрк_Начало Программное добавление элементов на формы документов (Задание 1 и 2)

Процедура ПриСозданииФормыДокумента(Форма) Экспорт
	
	// 1. Проверяем, что это форма именно элемента документа (не списка и не выбора)
	Если Найти(Форма.ИмяФормы, ".ФормаОбъекта") = 0 
	 И Найти(Форма.ИмяФормы, ".ФормаДокумента") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// 2. Проверяем, есть ли на форме основной реквизит "Объект"
	Если Не СвойствоФормы(Форма, "Объект") Тогда
		Возврат;
	КонецЕсли;
	
	// 3. Получаем имя документа из его данных безопасным способом
	ИмяДокумента = Форма.Объект.Ссылка.Метаданные().Имя;
	
	// 4. Проверяем, добавлен ли реквизит "КонтактноеЛицо" в этот документ в конфигураторе
	Если Метаданные.Документы[ИмяДокумента].Реквизиты.Найти("КонтактноеЛицо") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// 5. Проверяем, не создали ли мы этот элемент ранее
	Если Форма.Элементы.Найти("дрк_КонтактноеЛицо") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// 6. Находим элемент формы "Договор", под который по условию нужно встать
	ЭлементДоговор = Форма.Элементы.Найти("Договор");
	Если ЭлементДоговор = Неопределено Тогда
		// Если поля Договор вдруг нет, ищем стандартную группу шапки
		РодительЭлемента = Форма.Элементы.Найти("ГруппаШапка"); 
	Иначе
		РодительЭлемента = ЭлементДоговор.Родитель;
	КонецЕсли;
	
	// 7. Программно создаем поле ввода (передаем строго 3 параметра)
	НовыйЭлемент = Форма.Элементы.Добавить("дрк_КонтактноеЛицо", Тип("ПолеФормы"), РодительЭлемента);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.КонтактноеЛицо";
	НовыйЭлемент.Заголовок = "Контактное лицо";
	
	// 8. Если нашли Договор, сдвигаем наше поле так, чтобы оно встало СРАЗУ ПОСЛЕ него
	Если ЭлементДоговор <> Неопределено Тогда
		Форма.Элементы.Переместить(НовыйЭлемент, РодительЭлемента, ЭлементДоговор);
	КонецЕсли;
	
	// === ДОРАБОТКА ПО ЗАДАЧЕ 2: СКИДКА В ЗАКАЗЕ ПОКУПАТЕЛЯ ===
	Если ИмяДокумента = "ЗаказПокупателя" Тогда
		
		// 1. Программно создаем поле "Согласованная скидка"
		Если Форма.Элементы.Найти("дрк_СогласованнаяСкидка") = Неопределено Тогда
			ПолеСкидка = Форма.Элементы.Добавить("дрк_СогласованнаяСкидка", Тип("ПолеФормы"), РодительЭлемента);
			ПолеСкидка.Вид = ВидПоляФормы.ПолеВвода;
			ПолеСкидка.ПутьКДанным = "Объект.др_СогласованнаяСкидка";
			ПолеСкидка.Заголовок = "Согласованная скидка";
			
			// Указываем имя процедуры, которая БУДЕТ жить в самой форме
			ПолеСкидка.УстановитьДействие("ПриИзменении", "дрк_СогласованнаяСкидкаПриИзменении");
		КонецЕсли;
		
		// 2. Программно создаем кнопку "Пересчитать скидку" на командной панели товаров
		КоманднаяПанельТоваров = Форма.Элементы.Найти("ТоварыКоманднаяПанель");
		Если КоманднаяПанельТоваров <> Неопределено И Форма.Элементы.Найти("дрк_КнопкаПересчета") = Неопределено Тогда
			
			// Создаем команду в форме, которая вызовет метод формы
			НоваяКоманда = Форма.Команды.Добавить("дрк_ПересчитатьСуммыСоСкидкой");
			НоваяКоманда.Действие = "дрк_ПересчитатьСуммыСоСкидкой";
			НоваяКоманда.Заголовок = "Пересчитать скидку";
			
			// Создаем кнопку на панели и привязываем к ней команду
			Кнопка = Форма.Элементы.Добавить("дрк_КнопкаПересчета", Тип("КнопкаФормы"), КоманднаяПанельТоваров);
			Кнопка.ИмяКоманды = "дрк_ПересчитатьСуммыСоСкидкой";
		КонецЕсли;
		
	КонецЕсли;
	КонецПроцедуры
	
	// Вспомогательная функция для безопасной проверки наличия реквизита у формы
Функция СвойствоФормы(Форма, ИмяСвойства) Экспорт
	Попытка
		Значение = Форма[ИмяСвойства];
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции
	
