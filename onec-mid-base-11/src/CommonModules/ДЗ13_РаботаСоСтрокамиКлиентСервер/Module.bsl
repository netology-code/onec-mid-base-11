#Область СлужебныеПроцедурыИФункции

Функция СократитьФИО(ФИО) Экспорт;
	
	МассивИмен = СтрРазделить( ФИО, " ", Ложь );
	Если МассивИмен.Количество()<> 3 Тогда
		Возврат ФИО;
	КонецЕсли;
	
	КороткоеИмя = СтрШаблон( "%1 %2.%3.", МассивИмен[0], Лев(МассивИмен[1], 1), Лев(МассивИмен[2], 1) );
	
	Возврат КороткоеИмя;
	
КонецФункции

#КонецОбласти