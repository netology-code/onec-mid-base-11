Процедура ДополнитьФормуКонтакт(форма) Экспорт
	
	Если Форма.ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаДокумента" Тогда
		ДобавитьКонтактноеЛицоВШапкуВправо(Форма);
		ДобавитьСкидкуИКнопку(Форма);
	ИначеЕсли Форма.ИмяФормы = "Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокумента" Тогда
		ДобавитьКонтактноеЛицоВШапкуВправо(Форма);  
	ИначеЕсли Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
		ДобавитьКонтактноеЛицоВШапкуВправо(Форма);
	ИначеЕсли Форма.ИмяФормы = "Документ.ОплатаОтПокупателя.Форма.ФормаДокумента" Тогда
		ДобавитьКонтактноеПередДоговор(Форма);  
	ИначеЕсли Форма.ИмяФормы = "Документ.ОплатаПоставщику.Форма.ФормаДокумента" Тогда
		ДобавитьКонтактноеПередДоговор(Форма)	
	КонецЕсли;	
	
	
КонецПроцедуры 

Процедура ДобавитьКонтактноеЛицоВШапкуВправо(Форма)
	
	ПолеВвода = Форма.Элементы.Добавить("КонтактноеЛицо", Тип("ПолеФормы"), Форма.Элементы.ГруппаШапкаПраво);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.КонтактноеЛицо_ИБ";
	
КонецПроцедуры  

Процедура ДобавитьКонтактноеПередДоговор(Форма)
	
	ПолеВвода = Форма.Элементы.Вставить("КонтактноеЛицо", Тип("ПолеФормы"), , Форма.Элементы.Договор);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.КонтактноеЛицо_ИБ";
	
КонецПроцедуры 

Процедура ДобавитьСкидкуИКнопку(Форма) Экспорт
	
	
	Если Форма.Элементы.Найти("ГруппаСкидка") = Неопределено Тогда
		
		НоваяГруппа = Форма.Элементы.Вставить("ГруппаСкидка", Тип("ГруппаФормы"), Форма.Элементы.ГруппаШапкаЛево);
		
		НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		НоваяГруппа.ОтображатьЗаголовок = Ложь; 
        НоваяГруппа.Заголовок = "Дополнительные реквизиты";
     	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		
		
	КонецЕсли;
	
	ИмяРеквизита = "СогласованнаяСкидка";
	
	НовоеПоле = Форма.Элементы.Добавить("Поле" + ИмяРеквизита, Тип("ПолеФормы"), Форма.Элементы.ГруппаСкидка);
	
	НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
	НовоеПоле.ПутьКДанным = "Объект." + ИмяРеквизита; 
	НовоеПоле.МаксимальноеЗначение = 100;
	НовоеПоле.УстановитьДействие("ПриИзменении", "ЕслиИзменяетьсяСкидка");
	
	ИмяКоманды = "РассчитатьСкидку";
    НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Заголовок = "Рассчитать скидку";
    НоваяКоманда.Действие = "РассчитатьСкидкуВместо";
	
	РодительЭлемента = Форма.Элементы.ГруппаСкидка; 
    НоваяКнопка = Форма.Элементы.Добавить("Кнопка" + ИмяКоманды, Тип("КнопкаФормы"), РодительЭлемента);

    НоваяКнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели; 
    НоваяКнопка.ИмяКоманды = ИмяКоманды; 
	
КонецПроцедуры

